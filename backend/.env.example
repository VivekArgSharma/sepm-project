# SkillBridge Backend Environment Configuration

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# You can use standard PG variables or a single DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillbridge_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Optional full connection URI (if preferred over individual variables)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/skillbridge_db

# Security & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars
JWT_EXPIRES_IN=24h

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
